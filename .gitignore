# python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# virtual envs
.venv/
venv/
env/

# jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# логи (например, если перенаправляешь uvicorn в файл)
*.log

# секреты / локальные переопределения конфига -- никогда не коммитить
.env
.env.*

# данные и обученные артефакты -- версионируются отдельно (DVC/S3/registry),
# а не через git; в репозитории остаётся только структура папок
data/*.csv
artifacts/*.joblib
artifacts/*.json
!data/.gitkeep
!artifacts/.gitkeep
